NEXT_PUBLIC_APP_NAME="GuestHoster"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Supabase PostgreSQL (Transaction Pooler port 6543 + Direct/Session port 5432)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Secret HMAC pour cookies de session et tokens email (`openssl rand -base64 32`)
AUTH_SECRET=

# Resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="hello@guesthoster.com"
MAIL_FROM_NAME="Guest Hoster"

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=guesthoster

# Secret partagé avec Vercel Cron (GET /internal/cron)
CRON_SECRET=

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# Règles de réservation
BOOKING_SERVICE_FEE_RATE=0.10
BOOKING_HOST_RESPONSE_HOURS=48
BOOKING_INSTANT_PAYMENT_MINUTES=60
BOOKING_APPROVED_PAYMENT_HOURS=24
BOOKING_FULL_REFUND_DAYS=7
BOOKING_LATE_REFUND_RATE=0.5
BOOKING_REVIEW_WINDOW_DAYS=30
